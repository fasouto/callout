{
  "description": "Opens each finished plan in Callout. Approving there approves the plan; feedback sends it back for revision.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/callout",
            "args": ["hook"],
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
