#!/bin/sh
# Runs the annotator tool that ships inside Annotator.app.
# The plugin contains no logic of its own: every trigger goes through that tool.

find_tool() {
  if [ -n "$ANNOTATOR_CLI" ] && [ -x "$ANNOTATOR_CLI" ]; then
    printf '%s\n' "$ANNOTATOR_CLI"
    return
  fi
  for app in "/Applications/Annotator.app" "$HOME/Applications/Annotator.app"; do
    if [ -x "$app/Contents/Helpers/annotator" ]; then
      printf '%s\n' "$app/Contents/Helpers/annotator"
      return
    fi
  done
  # A copy the user put on PATH. This script is itself on Claude Code's PATH,
  # so skip its own folder, and look only once in case another copy of this
  # script is found: two of them would otherwise hand over to each other forever.
  [ -n "$ANNOTATOR_SHIM" ] && return
  self=$(cd "$(dirname "$0")" && pwd)
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    if [ "$dir" != "$self" ] && [ -x "$dir/annotator" ]; then
      IFS=$old_ifs
      printf '%s\n' "$dir/annotator"
      return
    fi
  done
  IFS=$old_ifs
}

tool=$(find_tool)

if [ -z "$tool" ]; then
  echo "annotator: Annotator.app was not found. Put it in /Applications, or set ANNOTATOR_CLI to the annotator tool." >&2
  # The hook must stay silent on standard output, so Claude Code shows its own
  # plan dialog. Everything else says in one line that no review happened.
  if [ "$1" != "hook" ]; then
    echo "Annotator is not installed, so no review was done."
  fi
  exit 0
fi

ANNOTATOR_SHIM=1 exec "$tool" "$@"
